<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#2B6CB0</Color>
    <Color x:Key="PrimaryDark">#4A8FD1</Color>
    <Color x:Key="Secondary">#EDF2F7</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#1A1A1A</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray400">#A0AEC0</Color>
    <Color x:Key="Gray600">#4A5568</Color>

    <!-- Hintergrund im Dark Mode - dunkel genug für Kontrast, aber kein reines Schwarz. -->
    <Color x:Key="DarkBackground">#121417</Color>

    <!-- Status-Farben für Bestellungen (offen/sonstiges). -->
    <Color x:Key="StatusOpen">#2F855A</Color>
    <Color x:Key="StatusOther">#A0AEC0</Color>

</ResourceDictionary>
