<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- Für den Bilder-Upload (Kamera/Fotomediathek über MediaPicker, siehe ArticleDetailPage).
	     Ohne diese Beschreibungstexte lehnt iOS den Berechtigungs-Dialog beim Aufruf sofort ab. -->
	<key>NSCameraUsageDescription</key>
	<string>Wird benötigt, um Artikelfotos direkt mit der Kamera aufzunehmen.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wird benötigt, um Artikelfotos aus der Fotomediathek auszuwählen.</string>
</dict>
</plist>
