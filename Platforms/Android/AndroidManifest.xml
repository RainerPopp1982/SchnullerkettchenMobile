<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
    <!-- Wird für den direkten MySQL-Zugriff (Rohdaten-Socket, kein HTTP) benötigt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Für den Bilder-Upload (Kamera/Galerie über MediaPicker, siehe ArticleDetailPage). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ (API 33): granulare Medienberechtigung statt der alten Speicherberechtigung. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Ältere Android-Versionen: klassische Speicherberechtigung zum Lesen der Galerie. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Kamera ist optional, kein Geräte-Ausschluss beim Play Store/Sideload nötig. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
