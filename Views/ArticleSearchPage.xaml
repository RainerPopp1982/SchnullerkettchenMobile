<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SchnullerkettchenMobile.Models"
             x:Class="SchnullerkettchenMobile.Views.ArticleSearchPage"
             Title="Artikelsuche">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15" RowSpacing="8">

        <SearchBar Grid.Row="0" x:Name="SuchfeldBox" Placeholder="Artikelname oder Artikelnummer" SearchButtonPressed="OnSuchen" />

        <ActivityIndicator Grid.Row="1" x:Name="Ladeanzeige" IsRunning="False" IsVisible="False" />
        <Label Grid.Row="1" x:Name="LeerHinweis" Text="Keine Artikel gefunden." IsVisible="False"
               TextColor="{StaticResource Gray600}" HorizontalOptions="Center" Margin="0,20,0,0" />

        <CollectionView Grid.Row="2" x:Name="ArtikelListe">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ArticleSummary">
                    <Grid Padding="0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnArtikelTapped" CommandParameter="{Binding ID}" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Artikelname}" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding PreisText}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" TextColor="{StaticResource Gray600}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ID}" />
                                    <Span Text="  ·  Bestand: " />
                                    <Span Text="{Binding Bestand}" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding StatusText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,8,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
